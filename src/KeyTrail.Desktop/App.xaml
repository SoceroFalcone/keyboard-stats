<Application x:Class="KeyTrail.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:KeyTrail.Desktop.Controls"
 ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#181B21"/>
  <SolidColorBrush x:Key="Muted" Color="#5A6072"/>
  <SolidColorBrush x:Key="Accent" Color="#3B608F"/>
  <SolidColorBrush x:Key="Line" Color="#C9CFD8"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style x:Key="FocusRing" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate><Grid Margin="2"><Rectangle Stroke="White" StrokeThickness="4" RadiusX="6" RadiusY="6"/><Rectangle Stroke="#1F3A5C" StrokeThickness="2" RadiusX="6" RadiusY="6"/></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border><Border x:Name="FocusWhite" Margin="2" BorderBrush="White" BorderThickness="4" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/><Border x:Name="FocusDark" Margin="2" BorderBrush="#1F3A5C" BorderThickness="2" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#6B87B0"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#1F3A5C"/><Setter TargetName="Shell" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusWhite" Property="Visibility" Value="Visible"/><Setter TargetName="FocusDark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="KeyboardRegionButton" TargetType="{x:Type ui:KeyboardRegionButton}">
   <Setter Property="Focusable" Value="True"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:KeyboardRegionButton}">
    <Grid>
     <Image x:Name="Material" Source="{TemplateBinding HeatTexture}" Stretch="Fill" IsHitTestVisible="False"/>
     <Path x:Name="Shell" Data="{TemplateBinding Shape}" Stroke="Transparent" StrokeThickness="2" IsHitTestVisible="False"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Path x:Name="Selection" Data="{TemplateBinding Shape}" Stroke="#B8694A" StrokeThickness="3" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="FocusWhite" Data="{TemplateBinding Shape}" Stroke="White" StrokeThickness="5" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="FocusDark" Data="{TemplateBinding Shape}" Stroke="#1F3A5C" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Stroke" Value="#6B87B0"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Stroke" Value="#B8694A"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusWhite" Property="Visibility" Value="Visible"/><Setter TargetName="FocusDark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MouseRegionButton" TargetType="{x:Type ui:MouseRegionButton}">
   <Setter Property="Focusable" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:MouseRegionButton}">
    <Grid>
     <Image x:Name="Material" Source="{TemplateBinding HeatTexture}" Stretch="Fill" IsHitTestVisible="False"/>
     <Path x:Name="Shell" Data="{TemplateBinding Shape}" Stroke="Transparent" StrokeThickness="4" IsHitTestVisible="False"/>
     <Path x:Name="Selection" Data="{TemplateBinding Shape}" Stroke="#B8694A" StrokeThickness="4" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="FocusWhite" Data="{TemplateBinding Shape}" Stroke="White" StrokeThickness="8" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Path x:Name="FocusDark" Data="{TemplateBinding Shape}" Stroke="#1F3A5C" StrokeThickness="3" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Stroke" Value="#6B87B0"/></Trigger>
     <Trigger Property="IsEmphasized" Value="True"><Setter TargetName="Shell" Property="Stroke" Value="#6B87B0"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Stroke" Value="#B8694A"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusWhite" Property="Visibility" Value="Visible"/><Setter TargetName="FocusDark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>
  <Style x:Key="NavButton" TargetType="RadioButton">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#5A6072"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,3"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid><Border x:Name="Nav" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="FocusWhite" Margin="2" BorderBrush="White" BorderThickness="4" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/><Border x:Name="FocusDark" Margin="2" BorderBrush="#1F3A5C" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Nav" Property="Background" Value="#D8E2EE"/><Setter Property="Foreground" Value="#1F3A5C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="#D0D9E5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusWhite" Property="Visibility" Value="Visible"/><Setter TargetName="FocusDark" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,6,0,4"/></Style>
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Padding" Value="15,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#D8E2EE"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="White"/><Setter TargetName="Tile" Property="BorderBrush" Value="#6B87B0"/><Setter Property="Foreground" Value="#1F3A5C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,8,0,6"/><Setter Property="Padding" Value="6,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
  <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" FontSize="13" Foreground="#5A6072" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5"/></DataTemplate>
  <Style x:Key="CalendarDay" TargetType="CalendarDayButton">
   <Setter Property="FontSize" Value="14"/><Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="30"/><Setter Property="Margin" Value="1"/>
   <Setter Property="Foreground" Value="#181B21"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CalendarDayButton">
    <Border x:Name="Day" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="#6B87B0"/></Trigger>
     <Trigger Property="IsInactive" Value="True"><Setter Property="Foreground" Value="#5A6072"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="#E8EAEE"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="#3B608F"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Foreground" Value="#9DA5B2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DatePicker">
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/>
   <Setter Property="MinHeight" Value="38"/><Setter Property="FirstDayOfWeek" Value="Monday"/><Setter Property="SelectedDateFormat" Value="Short"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CalendarStyle"><Setter.Value><Style TargetType="Calendar"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#6B87B0"/><Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDay}"/><Setter Property="CalendarButtonStyle"><Setter.Value><Style TargetType="CalendarButton"><Setter Property="FontSize" Value="14"/><Setter Property="MinWidth" Value="66"/><Setter Property="MinHeight" Value="38"/></Style></Setter.Value></Setter></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DatePicker">
    <Border x:Name="DateShell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
     <Grid x:Name="PART_Root">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <DatePickerTextBox x:Name="PART_TextBox" BorderThickness="0" Background="Transparent" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Padding="10,6,0,6" VerticalContentAlignment="Center"/>
      <Button x:Name="PART_Button" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="7" MinHeight="34" Focusable="False" ToolTip="打开日历" AutomationProperties.Name="打开日历">
       <Path Width="16" Height="16" Stretch="Uniform" Stroke="#3B608F" StrokeThickness="1.5" Data="M3,4 H17 V18 H3 Z M3,8 H17 M6,1 V6 M14,1 V6 M6,11 H8 M11,11 H14 M6,14 H8"/>
      </Button>
      <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False" PopupAnimation="None"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DateShell" Property="BorderBrush" Value="#3B608F"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#181B21"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/></Style>
 </Application.Resources>
</Application>
